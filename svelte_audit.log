    <div class='custom-switch'>
      <input type='checkbox' id='autohide-miniplayer' bind:checked={settings.autoHideMiniplayer} />
      <label for='autohide-miniplayer'>{settings.autoHideMiniplayer ? 'On' : 'Off'}</label>
