        <TorrentCard data={torrent} {disableRescan}/>
      {/each}
      {#each filteredSeeding as torrent (torrent.infoHash)}
        <TorrentCard data={torrent} {disableRescan}/>
      {/each}
      {#each filteredCompleted as torrent (torrent.infoHash)}
        <TorrentCard data={torrent} completed={true} {disableRescan}/>
