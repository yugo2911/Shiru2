        let rows = {}
        items.forEach(item => {
            const top = item.offsetTop
            if (!rows[top]) rows[top] = []
            rows[top].push(item)
        })
        Object.values(rows).forEach(rowItems => rowItems[0]?.classList.add('first-audio'))
    }

