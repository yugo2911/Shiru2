<SoftModal class='w-auto mw-350 d-flex justify-content-center flex-column scrollbar-none bg-very-dark p-30 mx-20 mb-30 mt-20 rounded' bind:showModal={$modal[modal.PROFILE]} {close} id={modal.PROFILE}>
