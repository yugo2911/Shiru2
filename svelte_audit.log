  }
  /* Next-to-watch target — accent left border */
  .scale-target .episode-card {
    border-left: 3px solid #d4f55e !important;
    background: rgba(212,245,94,0.04) !important;
  }

  /* ── Title ──────────────────────────────────── */
  .title {
    display: -webkit-box !important;
