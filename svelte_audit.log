    font-family: 'Syne', sans-serif !important;
    font-size: 1.45rem !important;
    font-weight: 800 !important;
    letter-spacing: -0.02em !important;
    color: #ededea !important;
  }

  /* ── Duration label ─────────────────────────── */
  .ml-auto.pl-5 {
    font-family: 'IBM Plex Mono', monospace;
