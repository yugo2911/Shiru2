							<Icon type="success" />
						</slot>
						<slot name="error-icon" slot="error-icon">
							<Icon type="error" />
						</slot>
						<slot name="warning-icon" slot="warning-icon">
							<Icon type="warning" />
						</slot>
						<slot name="info-icon" slot="info-icon">
							<Icon type="info" />
						</slot>
					</Toast>
