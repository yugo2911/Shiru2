    background: rgba(237,237,234,0.10) !important;
    border-color: rgba(255,255,255,0.22) !important;
    color: #ededea !important;
  }

  /* ── Synopsis section header ─────────────────── */
  hr {
    border-color: rgba(255,255,255,0.07) !important;
