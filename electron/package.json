{
  "name": "shiru",
  "version": "6.9.1",
  "license": "GPL-3.0-or-later",
  "packageManager": "bun@1.3.11",
  "private": true,
  "author": "RockinChaos <maintainer@shiru.app>",
  "description": "A personal anime library manager for watching and tracking your collection in real time. Lightweight, powerful, and paws-itively fast. No waiting required!",
  "main": "build/main.js",
  "homepage": "https://shiru.app/",
  "desktopName": "com.github.rockinchaos.shiru.desktop",
  "scripts": {
    "start": "cross-env NODE_ENV=development webpack build && concurrently --kill-others \"npm run web:watch\" \"npm run electron:start\"",
    "web:watch": "webpack serve",
    "web:build": "cross-env NODE_ENV=production webpack build",
    "electron:start": "cross-env electron ./build/main.js --ozone-platform-hint=auto --enable-features=WaylandWindowDecorations,--ozone-platform=wayland --enable-accelerated-2d-canvas --enable-zero-copy --ignore-gpu-blocklist --enable-gpu-rasterization --ignore-certificate-errors",
    "build": "npm run web:build && electron-builder",
    "electron:build": "electron-builder",
    "publish": "npm run web:build && electron-builder -p always"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "client": "workspace:*",
    "common": "workspace:*",
    "electron": "42.11.0",
    "electron-builder": "^26.17.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.10",
    "concurrently": "^10.0.6"
  },
  "dependencies": {
    "@paymoapp/electron-shutdown-handler": "^1.2.0",
    "@xhayper/discord-rpc": "^1.3.4",
    "utp-native": "^2.5.3"
  },
  "standard": {
    "ignore": [
      "bundle.js",
      "bundle.map.js"
    ],
    "env": [
      "browser",
      "node"
    ]
  }
}
