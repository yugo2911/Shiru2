#  this to create the entry automatically
cat > ~/.local/share/applications/shiru.desktop <<EOF
[Desktop Entry]
Name=Shiru
Exec=$(pwd)/shiru
Icon=$(pwd)/resources/icon.png
Type=Application
Categories=Development;
Terminal=false
EOF

# Update the database
update-desktop-database ~/.local/share/applications


