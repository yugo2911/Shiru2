"build": {
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Development",
    "executableName": "shiru",
    "desktop": {
      "Name": "Shiru",
      "Type": "Application",
      "Exec": "shiru",
      "Icon": "icon"
    }
  }
